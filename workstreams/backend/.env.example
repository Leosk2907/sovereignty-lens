# Sovereignty Lens - backend environment template
#
# Everything here is relative to workstreams/backend, which is where the
# backend stack is started:
#
#   cd workstreams/backend
#   cp .env.example .env          (Git Bash / macOS / Linux)
#   Copy-Item .env.example .env   (PowerShell)
#   docker compose up
#
# .env is gitignored and must never be committed. This template contains
# variable names and descriptions only - never real passwords or secrets.
# Every variable below is required; `docker compose up` fails with a readable
# error if any of them is missing or empty.


# ---------------------------------------------------------------------------
# PostgreSQL container (service `db`)
# ---------------------------------------------------------------------------

# Database name created on first start of the postgres container.
POSTGRES_DB=

# Database superuser created on first start of the postgres container.
POSTGRES_USER=

# Password for POSTGRES_USER. Any non-empty value works for a local demo; it
# never leaves the machine because port 5432 is published to 127.0.0.1 only.
POSTGRES_PASSWORD=

# Password for `sovereignty_app`, the least-privilege role the API actually
# connects as. It is created on first start by docker/initdb and may only
# select, insert and update rows - never drop a table or delete a row. Use a
# different value from POSTGRES_PASSWORD.
APP_DB_PASSWORD=


# ---------------------------------------------------------------------------
# Spring Boot datasource (service `api`)
#
# The API talks to the database over the compose network, so the host is the
# service name `db`, not localhost.
#
# The username and password are NOT set here: compose wires the API to the
# `sovereignty_app` role using APP_DB_PASSWORD, and gives Flyway the POSTGRES_*
# owner credentials separately, because applying migrations needs ownership
# that the running service deliberately does not have.
# ---------------------------------------------------------------------------

# JDBC URL. For the compose setup this is:
#   jdbc:postgresql://db:5432/<POSTGRES_DB>
SPRING_DATASOURCE_URL=


# ---------------------------------------------------------------------------
# Application secrets
#
# Generate fresh random values, for example:
#   openssl rand -base64 32
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# Never reuse a value across environments and never commit one.
# ---------------------------------------------------------------------------

# Shared presenter password for the /admin route.
APP_ADMIN_PASSWORD=

# Signing key for the admin session cookie. Use at least 32 random bytes.
APP_AUTH_SECRET=

# Server-side key used to hash the anonymous browser UUID before storage, so
# raw contributor identifiers are never persisted. Use at least 32 random bytes.
APP_CONTRIBUTOR_HASH_SECRET=


# ---------------------------------------------------------------------------
# LAN / QR-code configuration  <-- READ THIS BEFORE THE DEMO
#
# The backend generates the QR code that the audience scans. Whatever URL you
# put in APP_PUBLIC_BASE_URL is what gets encoded into that QR code, so it must
# be an address that a PHONE can open - not an address that only works on the
# presenter laptop.
#
#   WRONG:  http://localhost:3000    - on a phone, "localhost" is the phone
#   WRONG:  http://127.0.0.1:3000      itself, so the QR code opens nothing
#   RIGHT:  http://192.168.1.42:3000 - the laptop's LAN IPv4 address
#
# Find the correct value by running one of the helper scripts:
#
#   bash scripts/lan-url.sh          (Git Bash / macOS / Linux)
#   ./scripts/lan-url.ps1            (PowerShell)
#
# The laptop and the phones must be on the same Wi-Fi network, and the Windows
# firewall must allow inbound connections on the published ports. The address
# changes when you join a different network, so re-check it at the venue and
# restart the stack (`docker compose up -d`) after changing this value.
# ---------------------------------------------------------------------------

# Base URL of the audience-facing frontend, e.g. http://192.168.1.42:3000
# The contribution URL encoded in the QR code is <APP_PUBLIC_BASE_URL>/contribute
APP_PUBLIC_BASE_URL=

# Comma-separated list of browser origins allowed to call the API. Include the
# same LAN origin used above plus any local development origin, e.g.
#   http://192.168.1.42:3000,http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=
